# ==========================================================
#  متغیرهای محیطی مورد نیاز
#  در Railway این‌ها را در بخش Variables وارد کنید.
#  این فایل را هرگز با مقادیر واقعی در گیت کامیت نکنید.
# ==========================================================

# --- اعتبارنامه تلگرام (از my.telegram.org) ---
API_ID=1234567
API_HASH=your_api_hash_here

# --- توکن ربات اصلی (از @BotFather) ---
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- رشته سشن هلپر (خروجی gen_session.py) ---
# هشدار: معادل دسترسی کامل به اکانت تلگرام است
CLI_SESSION=paste_the_long_string_from_gen_session_here

# --- شناسه‌های عددی ---
# OWNER_ID = شناسه عددی خودتان (برنامه‌نویس)
# SUDO_ID  = شناسه عددی ادمین اصلی
OWNER_ID=123456789
SUDO_ID=123456789

# --- مسیرها ---
# DB_PATH باید داخل Volume باشد، وگرنه با هر deploy پاک می‌شود
DB_PATH=/app/data/database.sqlite
DOWNLOAD_PATH=/app/downloads/

# --- اختیاری ---
DEVICE_MODEL=MusicPlayerHelper
TZ=Asia/Tehran

# --- شخصی‌سازی (جایگزین اطلاعات واقعی سازندهٔ اول) ---
# لینک کانال ربات شما
CHANNEL_LINK=https://t.me/your_channel_link

# اطلاعات پرداخت (در پاسخ دستورات بانکی نمایش داده می‌شود)
CARD_NUMBER_1=0000-0000-0000-0000
CARD_NUMBER_2=0000-0000-0000-0000
CARD_HOLDER=نام شما

# نام بانک‌ها — BANK_NAME_2 به‌عنوان هشتگ استفاده می‌شود، پس فاصله نداشته باشد
BANK_NAME_1=بانک شما
BANK_NAME_2=بانک_شما
